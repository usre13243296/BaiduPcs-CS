<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BaiduPcsAPP.ViewModels"
             x:Class="BaiduPcsAPP.Views.TransfersView"
             x:DataType="vm:TransfersViewModel">

    <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,8,12,4">
            <TextBlock Text="传输" FontSize="13" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Opacity="0.6" FontSize="12" VerticalAlignment="Center" Margin="8,0"
                       Text="{Binding RunningCount, StringFormat={}{0} 个进行中}">
            </TextBlock>
            <Button Grid.Column="2" Content="{Binding ExpandText}" />
        </Grid>

        <ListBox Grid.Row="1" ItemsSource="{Binding Tasks}" MaxHeight="200"
                 BorderThickness="0" Background="Transparent"
                 IsVisible="{Binding HasTasks}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:TransferTaskViewModel">
                    <Grid ColumnDefinitions="*,Auto" MinHeight="44" Margin="4,2">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding StateText}" FontSize="12" Opacity="0.6"
                                           Margin="8,0,0,0" />
                            </Grid>
                            <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4" />
                            <!-- 失败/取消时显示错误详情 -->
                            <TextBlock Text="{Binding DetailText}" FontSize="11" Opacity="0.6"
                                       TextWrapping="Wrap" IsVisible="{Binding HasDetail}" />
                            <!-- 操作按钮：可用性由状态驱动（CanPause/CanResume/CanCancel/CanDelete） -->
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Content="暂停" FontSize="11" Padding="8,2" Command="{Binding PauseCommand}"
                                        IsVisible="{Binding CanPause}" />
                                <Button Content="继续" FontSize="11" Padding="8,2" Command="{Binding ResumeCommand}"
                                        IsVisible="{Binding CanResume}" />
                                <Button Content="取消" FontSize="11" Padding="8,2" Command="{Binding CancelCommand}"
                                        IsVisible="{Binding CanCancel}" />
                                <Button Content="删除" FontSize="11" Padding="8,2" Command="{Binding DeleteCommand}"
                                        IsVisible="{Binding CanDelete}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding SpeedText}" FontSize="12" Opacity="0.6"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="1" Text="暂无传输任务" Opacity="0.4" HorizontalAlignment="Center" Margin="0,12"
                   IsVisible="{Binding HasNoTasks}" />
    </Grid>
</UserControl>
