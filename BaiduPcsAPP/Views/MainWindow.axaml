<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BaiduPcsAPP.ViewModels"
        xmlns:views="using:BaiduPcsAPP.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
        x:Class="BaiduPcsAPP.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="BaiduPcs - 百度网盘客户端"
        Width="1200" Height="760"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="*,Auto">
        <!-- ========== 主区域：左导航 + 内容 ========== -->
        <Grid Grid.Row="0" ColumnDefinitions="220,*">
            <!-- 左侧导航栏 -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}">
                <DockPanel LastChildFill="True">
                    <!-- 账号区 -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="16" Spacing="8">
                        <Border Background="{DynamicResource ContentBackground}"
                                CornerRadius="10" Padding="12"
                                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="34" Height="34" CornerRadius="17"
                                            Background="{DynamicResource AccentColor}">
                                        <TextBlock Text="{Binding AvatarText}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="White" FontWeight="Bold" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding AccountName}" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="130" />
                                        <TextBlock Text="百度网盘" FontSize="11" Opacity="0.5" />
                                    </StackPanel>
                                </StackPanel>
                                <Button Content="退出登录" Command="{Binding LogoutCommand}"
                                        FontSize="11" Background="Transparent" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 品牌 + 导航 -->
                    <StackPanel Margin="8,16,8,0" Spacing="4">
                        <StackPanel Margin="12,0,12,16" Spacing="2">
                            <TextBlock Text="BaiduPcs" FontSize="22" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentColor}" />
                            <TextBlock Text="百度网盘客户端" FontSize="11" Opacity="0.5" />
                        </StackPanel>

                        <Button Classes="nav" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Content="📁  文件" Command="{Binding NavigateToCommand}" CommandParameter="0" />
                        <Button Classes="nav" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Content="📥  传输" Command="{Binding NavigateToCommand}" CommandParameter="1" />
                        <Button Classes="nav" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Content="⚙  设置" Command="{Binding NavigateToCommand}" CommandParameter="2" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 主内容区 -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*">
                <!-- 顶部栏 -->
                <Border Grid.Row="0" Padding="20,14"
                        BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding TopBarTitle}" FontSize="17" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding FileBrowser.QuotaText}"
                                   FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- 页面内容 -->
                <ContentControl Grid.Row="1" Content="{Binding SelectedPage}" />
            </Grid>
        </Grid>

        <!-- ========== 底部传输面板（文件页可见） ========== -->
        <Border Grid.Row="1" Background="{DynamicResource ContentBackground}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0"
                IsVisible="{Binding IsTransferDockVisible}">
            <views:TransfersView DataContext="{Binding Transfers}" />
        </Border>
    </Grid>
</Window>
