<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BaiduPcsAPP.ViewModels"
             x:Class="BaiduPcsAPP.Views.FileBrowserView"
             x:DataType="vm:FileBrowserViewModel">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- 工具栏 -->
        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto" Margin="16,12,16,8" ColumnSpacing="8">
            <Button Grid.Column="0" Content="⟵" ToolTip.Tip="上级目录" Command="{Binding GoUpCommand}" MinWidth="36" />
            <Button Grid.Column="1" Content="⟳" ToolTip.Tip="刷新" Command="{Binding RefreshCommand}" MinWidth="36" />

            <ItemsControl Grid.Column="2" VerticalAlignment="Center" ItemsSource="{Binding Breadcrumbs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding}" Background="Transparent"
                                    Command="{Binding $parent[ItemsControl].((vm:FileBrowserViewModel)DataContext).NavigateToCommand}"
                                    CommandParameter="{Binding}" />
                            <TextBlock Text="›" VerticalAlignment="Center" Opacity="0.4" Margin="2,0" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Grid.Column="3" Content="新建文件夹" Command="{Binding CreateFolderCommand}" />
            <Button Grid.Column="4" Content="上传" Classes="accent" Command="{Binding UploadFilesCommand}" />
            <Button Grid.Column="5" Content="复制链接" Command="{Binding CopyDownloadLinkCommand}" />
            <Button Grid.Column="6" Content="下载" Command="{Binding DownloadSelectedCommand}" />
            <Button Grid.Column="7" Content="重命名" Command="{Binding RenameSelectedCommand}" />
            <Button Grid.Column="8" Content="删除" Command="{Binding DeleteSelectedCommand}" />
        </Grid>

        <!-- 文件列表 -->
        <Border Grid.Row="1" Margin="16,0,16,8"
                Background="{DynamicResource ContentBackground}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="10"
                ClipToBounds="True">
            <Grid>
                <ListBox x:Name="FileList"
                         ItemsSource="{Binding Files}"
                         SelectedItem="{Binding SelectedItem}"
                         DoubleTapped="OnFileDoubleTapped">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileItemViewModel">
                            <Grid ColumnDefinitions="32,*,110,150" MinHeight="44">
                                <TextBlock Grid.Column="0" Text="{Binding IconText}" FontSize="18"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0">
                                    <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding TypeText}" FontSize="11" Opacity="0.5" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="13"
                                           VerticalAlignment="Center" Opacity="0.75" />
                                <TextBlock Grid.Column="3" Text="{Binding ModifiedText}" FontSize="13"
                                           VerticalAlignment="Center" Opacity="0.75" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="加载中..." HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding IsLoading}" Opacity="0.5" />

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                            IsVisible="{Binding HasError}">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorColor}"
                               HorizontalAlignment="Center" />
                    <Button Content="重试" Command="{Binding RefreshCommand}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 状态栏 -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="16,4,16,12">
            <TextBlock Text="{Binding StatusText}" Opacity="0.6" FontSize="12" />
            <TextBlock Grid.Column="1" Text="{Binding QuotaText}" Opacity="0.6" FontSize="12" />
        </Grid>
    </Grid>
</UserControl>
